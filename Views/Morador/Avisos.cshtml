@model List<Aviso>
@{
    ViewData["Title"] = "Avisos";
}

<h2><i class="fas fa-bullhorn"></i> Avisos da Administração</h2>

@if (Model.Any())
{
    <div class="row">
        @foreach (var aviso in Model)
        {
            <div class="col-12 mb-3">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@aviso.Titulo</h5>
                        <small class="text-muted">
                            <i class="fas fa-calendar"></i> @aviso.DataPublicacao.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@Html.Raw(aviso.Conteudo.Replace("\n", "<br>"))</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Não há avisos disponíveis no momento.
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Voltar ao Perfil
    </a>
}

