@model List<Aviso>
@{
    ViewData["Title"] = "Avisos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-bullhorn"></i> Avisos da Administração</h2>
    <div>
        <a asp-action="Perfil" class="btn btn-outline-primary me-2">
            <i class="fas fa-user"></i> Meu Perfil
        </a>
        <a asp-action="EnviarFeedback" class="btn btn-success">
            <i class="fas fa-paper-plane"></i> Enviar Feedback
        </a>
    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="row">
        @foreach (var aviso in Model)
        {
            <div class="col-12 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-primary">@aviso.Titulo</h5>
                        <small class="text-muted">
                            <i class="fas fa-calendar"></i> @aviso.DataPublicacao.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@Html.Raw((aviso.Conteudo ?? string.Empty).Replace("\n", "<br>"))</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Não há avisos disponíveis no momento.
    </div>
}

<!-- Menu de navegação rápida -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-compass"></i> Navegação Rápida</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <a asp-action="Perfil" class="btn btn-outline-primary w-100">
                            <i class="fas fa-user"></i> Meu Perfil
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-action="EnviarFeedback" class="btn btn-outline-success w-100">
                            <i class="fas fa-paper-plane"></i> Enviar Feedback
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-action="MeusFeedbacks" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-list"></i> Meus Feedbacks
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-action="Edit" class="btn btn-outline-warning w-100">
                            <i class="fas fa-edit"></i> Editar Perfil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

